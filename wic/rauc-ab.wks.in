# imx-boot raw copy (offset from IMX_BOOT_SEEK)
part u-boot --source rawcopy --sourceparams="file=imx-boot" --ondisk mmcblk --no-table --align ${IMX_BOOT_SEEK}

# Boot partition (shared, only contains boot.scr) - starts at 8MB
part /boot --source bootimg-partition --ondisk mmcblk --fstype=vfat --label boot --active --align 8192 --fixed-size 64

# RootFS Slot system0 (EXT4) - contains /boot/Image and /boot/*.dtb
part / --source rootfs --ondisk mmcblk --fstype=ext4 --label rootfs_a --align 4096 --fixed-size 3072

# RootFS Slot system1 (EXT4) - initially empty, written during OTA
part --ondisk mmcblk --fstype=ext4 --label rootfs_b --align 4096 --fixed-size 3072

# Data partition - persistent data (5GB for user data)
part /data --source empty --ondisk mmcblk --fstype=ext4 --label data --align 4096 --fixed-size 5120

bootloader --ptable msdos